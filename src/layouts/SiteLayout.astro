---
import {ClientRouter} from 'astro:transitions';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import headingFont from '@fontsource/space-grotesk/files/space-grotesk-latin-500-normal.woff2?url';
import bodyFont from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
interface Props { title?: string; description?: string; project?: { title: string; description: string; source?: string }; }
const { title = 'Omar Alhalawani | ASIC Verification & Computer Systems Engineering', description = 'Computer Systems Engineering at Carleton University. ASIC verification experience at Ciena, RTL design, embedded systems, and engineering automation.', project } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/og.png', Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Person', '@id': `${Astro.site}#omar`, name: site.name, url: Astro.site?.href, email: site.email, sameAs: [site.github, site.linkedin], affiliation: {'@type':'CollegeOrUniversity',name:site.university}, knowsAbout:['ASIC verification','RTL design','Embedded systems','Engineering automation'] },
    { '@type': 'WebPage', name: title, description, url: canonical.href, about: {'@id':`${Astro.site}#omar`} },
    ...(project ? [{ '@type': 'CreativeWork', name: project.title, description: project.description, url: canonical.href, creator: {'@id':`${Astro.site}#omar`}, ...(project.source ? {isBasedOn:project.source} : {}) }] : []),
  ],
};
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07090b" />
    <ClientRouter fallback="swap" />
    <script>
      import {initializeProjectNavigation} from '../lib/project-navigation';
      initializeProjectNavigation();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="OA // SYSTEMS" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Omar Alhalawani — ASIC Verification and Computer Systems Engineering, with conceptual amber-and-steel hardware artwork" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')} />
  </head>
  <body transition:animate="none">
    <div class="technical-background" aria-hidden="true">
      <svg viewBox="0 0 1440 1000" preserveAspectRatio="xMidYMid slice"><g fill="none" stroke="currentColor"><path d="M0 230H210L310 330H550M1440 140H1170L1090 220V440H950M0 780H190L290 680V540M1440 830H1220L1120 730H900"/><path d="M90 80H420V180H90ZM1040 570H1350V680H1040Z" opacity=".4"/></g><g fill="currentColor"><circle cx="550" cy="330" r="3"/><circle cx="950" cy="440" r="3"/><circle cx="290" cy="540" r="3"/><circle cx="900" cy="730" r="3"/></g></svg>
      <div class="technical-energy"></div>
    </div>
    <SiteHeader />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>

<script>
  import {onPage} from '../lib/page-lifecycle';
  onPage(signal=>{
    const motion=matchMedia('(prefers-reduced-motion: reduce)');
    // Reveal content blocks once; never transform the retained project canvas.
    const blocks=document.querySelectorAll<HTMLElement>('[data-reveal],main .section-heading,main .about-details,main .contact-form-wrap,main .experience-card,main .case-prose > section,main .cta-band');
    if(motion.matches||!('IntersectionObserver' in window))return;
    const observer=new IntersectionObserver(entries=>{
      entries.forEach(entry=>{if(entry.isIntersecting){(entry.target as HTMLElement).dataset.revealState='visible';observer.unobserve(entry.target);}});
    },{threshold:0,rootMargin:'0px 0px -32px 0px'});
    blocks.forEach(block=>{
      // Avoid nested reveals and leave above-the-fold content immediately readable.
      if(block.parentElement?.closest('[data-reveal],.experience-card'))return;
      if(block.getBoundingClientRect().top<innerHeight-32)return;
      block.dataset.revealState='pending';observer.observe(block);
    });
    const show=()=>{blocks.forEach(block=>{delete block.dataset.revealState;});observer.disconnect();};
    motion.addEventListener('change',show,{signal});
    // Hidden tabs suspend the inexpensive background pulse.
    const visibility=()=>document.body.classList.toggle('background-paused',document.hidden);
    visibility();document.addEventListener('visibilitychange',visibility,{signal});
    return()=>{observer.disconnect();};
  });
</script>
