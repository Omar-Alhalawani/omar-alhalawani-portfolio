---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import headingFont from '@fontsource/space-grotesk/files/space-grotesk-latin-500-normal.woff2?url';
import bodyFont from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
interface Props { title?: string; description?: string; project?: { title: string; description: string; source?: string }; }
const { title = 'Omar Alhalawani | ASIC Verification & Computer Systems Engineering', description = 'Computer Systems Engineering at Carleton University. ASIC verification experience at Ciena, RTL design, embedded systems, and engineering automation.', project } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/og.png', Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Person', '@id': `${Astro.site}#omar`, name: site.name, url: Astro.site?.href, email: site.email, sameAs: [site.github, site.linkedin], affiliation: {'@type':'CollegeOrUniversity',name:site.university}, knowsAbout:['ASIC verification','RTL design','Embedded systems','Engineering automation'] },
    { '@type': 'WebPage', name: title, description, url: canonical.href, about: {'@id':`${Astro.site}#omar`} },
    ...(project ? [{ '@type': 'CreativeWork', name: project.title, description: project.description, url: canonical.href, creator: {'@id':`${Astro.site}#omar`}, ...(project.source ? {isBasedOn:project.source} : {}) }] : []),
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07090b" />
    <script is:inline>
      // Install the real WebGL handoff before first paint; loading/error states
      // retain it until the destination can show its scene or static fallback.
      try {
        const raw=sessionStorage.getItem('portfolio:project-handoff');
        if(raw){
          const handoff=JSON.parse(raw);
          if(location.pathname.replace(/\/$/,'')===`/projects/${handoff.id}`&&Date.now()-handoff.timestamp<15000&&/^data:image\/(webp|png);base64,/.test(handoff.image)){
            window.__PROJECT_HANDOFF__=handoff;
            const overlay=document.createElement('div');overlay.id='project-handoff';overlay.className='project-handoff';overlay.setAttribute('aria-hidden','true');
            overlay.style.cssText='position:fixed;inset:0;z-index:50;background:#07090b;pointer-events:none;display:grid;place-items:center;view-transition-name:project-handoff';
            const image=document.createElement('img');image.src=handoff.image;image.alt='';image.style.cssText='width:100%;height:100%;object-fit:contain';overlay.append(image);document.documentElement.append(overlay);
            const reveal=()=>{
              window.dispatchEvent(new Event('portfolio:handoff-reveal'));
              const hero=document.querySelector('.case-canvas')?.getBoundingClientRect();
              if(hero){image.style.cssText='position:absolute;left:0;top:0;width:100%;height:100%;object-fit:contain;transition:left 240ms ease,top 240ms ease,width 240ms ease,height 240ms ease';image.getBoundingClientRect();image.style.left=`${hero.left}px`;image.style.top=`${hero.top}px`;image.style.width=`${hero.width}px`;image.style.height=`${hero.height}px`;}
              overlay.classList.add('project-handoff-revealing');setTimeout(()=>overlay.remove(),260);
            };
            const deadline=setTimeout(reveal,6000);
            window.addEventListener('portfolio:destination-ready',()=>{clearTimeout(deadline);setTimeout(reveal,100);},{once:true});
          }
          sessionStorage.removeItem('portfolio:project-handoff');
        }
      }catch { /* Normal navigation works without session storage. */ }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="OA // SYSTEMS" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Omar Alhalawani — ASIC Verification and Computer Systems Engineering, with conceptual amber-and-steel hardware artwork" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')} />
  </head>
  <body>
    <SiteHeader />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
