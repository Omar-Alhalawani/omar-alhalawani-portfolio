---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import headingFont from '@fontsource/space-grotesk/files/space-grotesk-latin-500-normal.woff2?url';
import bodyFont from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
interface Props { title?: string; description?: string; project?: { title: string; description: string; source?: string }; }
const { title = 'Omar Alhalawani — Computer Systems Engineering & ASIC Verification', description = 'Computer Systems Engineering at Carleton University. ASIC verification experience at Ciena, RTL design, embedded systems, and engineering automation.', project } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/og.png', Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Person', '@id': `${Astro.site}#omar`, name: site.name, url: Astro.site?.href, email: site.email, sameAs: [site.github, site.linkedin], affiliation: {'@type':'CollegeOrUniversity',name:site.university}, knowsAbout:['ASIC verification','RTL design','Embedded systems','Engineering automation'] },
    { '@type': 'WebPage', name: title, description, url: canonical.href, about: {'@id':`${Astro.site}#omar`} },
    ...(project ? [{ '@type': 'CreativeWork', name: project.title, description: project.description, url: canonical.href, creator: {'@id':`${Astro.site}#omar`}, ...(project.source ? {isBasedOn:project.source} : {}) }] : []),
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#030610" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="OA // SYSTEMS" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Omar Alhalawani — ASIC Verification and Computer Systems Engineering, with original silicon artwork" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')} />
  </head>
  <body>
    <SiteHeader />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
