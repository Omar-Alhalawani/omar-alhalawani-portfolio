---
import type {Project} from '../data/projects';
interface Props { project:Project; }
const {project}=Astro.props;
const notes:Record<string,string>={
  fifo:'The memory datapath and occupancy control share a clock. The reference queue belongs to the testbench, outside the DUT.',
  'fpga-arithmetic':'DIP switches provide operand data. Five buttons pass through two-flop synchronizers and rising-edge detectors to control register capture, reset, and operation selection. The LED bank displays the low eight result bits.',
  emg:'A conceptual signal path from the documented project summary. The waveform on this page is synthetic; it is not a physiological recording.',
  lumalink:'A visible-light communication concept. The optional local summary and SOS interface consume decoded text; they are separate from optical capture.',
  cubex:'A mechanical and firmware integration concept. The public build is in progress; the printer illustration does not imply a completed or validated print.',
  'mini-lysimeter':'A conceptual research data-acquisition chain from the supplied resume. Implementation source is not publicly available.',
};
---
<figure class="architecture-diagram"><figcaption class="eyebrow">Architecture // Conceptual overview</figcaption>
  {project.id==='fpga-arithmetic'?<div class="datapath"><div class="path"><span>DIP[7:0]</span><span>A[7:0] + B[7:0]<small>Captured operands</small></span><span>Add / subtract<small>9-bit intermediate</small></span><span>LED[7:0]<small>Low 8 bits</small></span></div><div class="control-path"><span>5 buttons</span><span>2-flop synchronization</span><span>Rising-edge detection</span><span>Capture / mode / clear</span></div></div>:project.id==='fifo'?<div class="datapath"><div class="path"><span>din + write handshake</span><span>Memory array<small>Write / read pointers</small></span><span>Registered dout<small>After accepted read</small></span></div><div class="control-path"><span>Shared clock + rst_n</span><span>Occupancy count</span><span>wr_ready / rd_valid</span></div></div>:<ol class="path">{project.architecture.map(label=><li>{label}</li>)}</ol>}
  <p class="architecture-note">{notes[project.id]}</p>
</figure>
<style>
  .architecture-diagram { border-block:1px solid var(--line); padding-block:32px; margin-block:48px; }
  .architecture-diagram>.eyebrow { margin-bottom:24px; font-size:9px; }
  .path,.control-path { display:flex; flex-wrap:wrap; gap:18px; list-style:none; padding:0; margin:0; }
  .path>span,.path>li,.control-path>span { flex:1 1 140px; position:relative; padding:18px 14px; min-width:0; border:1px solid var(--line); background:var(--bg-raised); font:400 10px/1.8 var(--mono); color:var(--amber); }
  .path>li+li { margin:0; }
  .path>span:not(:last-child)::after,.path>li:not(:last-child)::after { content:'→'; position:absolute; right:-15px; top:18px; color:var(--muted); }
  small { display:block; font-size:9px; color:var(--muted); margin-top:6px; }
  .control-path { margin-top:18px; }
  .control-path>span { border-style:dashed; color:var(--read); font-size:9px; padding-block:12px; }
  .architecture-note { margin-top:22px; font-size:11px; line-height:1.85; color:var(--muted); }
  @media(max-width:650px) { .path,.control-path { display:grid; grid-template-columns:1fr 1fr; gap:12px; } .path>span,.path>li,.control-path>span { font-size:9px; padding:14px 12px; } .path>span::after,.path>li::after { display:none; } .architecture-diagram { margin-block:32px; } }
</style>
