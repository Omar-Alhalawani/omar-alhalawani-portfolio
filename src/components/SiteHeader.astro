---
import { navigation } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = (href: string) => href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Omar Alhalawani home"><span class="brand-mark">OA<span class="brand-dot">.</span></span><span class="brand-label">// SYSTEMS</span></a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {navigation.map(({href,label}) => <a href={href} class:list={[{active:active(href)}, {'nav-resume':href === '/resume'}]} aria-current={active(href) ? 'page' : undefined}>{label}{href === '/resume' && <span aria-hidden="true"> ↗</span>}</a>)}
    </nav>
    <details class="mobile-nav">
      <summary>Menu <span class="menu-icon" aria-hidden="true"><i></i><i></i></span></summary>
      <nav aria-label="Mobile navigation">{navigation.map(({href,label}) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}<span aria-hidden="true">↗</span></a>)}</nav>
    </details>
  </div>
</header>
