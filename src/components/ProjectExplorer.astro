---
import SceneIsland from './SceneIsland';
import ProjectCard from './ProjectCard.astro';
import type {Project} from '../data/projects';
interface Props { projects:Project[]; }
const {projects}=Astro.props;
const mobileOrder=['fifo','fpga-arithmetic','emg','lumalink','cubex','mini-lysimeter'];
const mobileProjects=[...projects].sort((a,b)=>mobileOrder.indexOf(a.id)-mobileOrder.indexOf(b.id));
---
<div class="project-explorer" data-project-world data-selected="fifo">
  <div class="project-map-column"><div class="project-map">
    <div class="world-instruction"><span>PROJECT PLATFORM</span><span class="webgl-hint">Hover or tap a module</span><span class="fallback-hint">Select a project entry</span></div>
    <div class="mobile-project-selector" aria-label="Select a project">{mobileProjects.map(project=><button type="button" data-select-project={project.id} aria-pressed={project.id==='fifo'?'true':'false'}>{{fifo:'FIFO','fpga-arithmetic':'FPGA',emg:'EMG',lumalink:'LumaLink',cubex:'CubeX','mini-lysimeter':'DAQ'}[project.id]}</button>)}</div>
    <div class="platform-canvas"><SceneIsland scene="floorplan" client:visible /></div>
    <div class="project-preview" aria-live="polite" aria-atomic="true">
      {projects.map(project=><div data-preview={project.id} hidden={project.id!=='fifo'}><p class="eyebrow">{project.category}</p><h3><span class="project-title-full">{project.title}</span><span class="project-title-mobile">{project.id==='cubex'?'CubeX':project.shortTitle}</span></h3><p>{project.description}</p><a class="text-link" href={`/projects/${project.id}`}>Open Project <span aria-hidden="true">→</span></a></div>)}
    </div>
    <p class="art-caption">Select a module, then open its case study.</p>
  </div></div>
  <div class="project-list" aria-label="Featured project links">{projects.map((project,index)=><ProjectCard project={project} index={index}/>)}</div>
</div>
<script>
  import {setProjectIntent,selectProject} from '../lib/project-selection';
  import {openProject,lastSelectedProject} from '../lib/project-navigation';
  import {onPage} from '../lib/page-lifecycle';
  onPage(signal=>{
  const worlds=document.querySelectorAll<HTMLElement>('[data-project-world]');
  const update=(id:string)=>worlds.forEach(world=>{
    world.dataset.selected=id;
    world.querySelectorAll<HTMLButtonElement>('[data-select-project]').forEach(button=>{const selected=button.dataset.selectProject===id;button.setAttribute('aria-pressed',String(selected));if(selected&&innerWidth<=800)button.parentElement?.scrollTo({left:button.offsetLeft-button.parentElement.clientWidth/2+button.clientWidth/2,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});});
    world.querySelectorAll<HTMLElement>('[data-project]').forEach(card=>{if(card.dataset.project===id)card.setAttribute('data-active','true');else card.removeAttribute('data-active');});
    world.querySelectorAll<HTMLElement>('[data-preview]').forEach(preview=>{preview.hidden=preview.dataset.preview!==id;});
  });
  worlds.forEach(world=>{
    const selected=lastSelectedProject()||world.dataset.selected||'fifo';update(selected);selectProject(selected);
    world.querySelectorAll<HTMLButtonElement>('[data-select-project]').forEach(button=>button.addEventListener('click',()=>{world.dataset.engaged='true';setProjectIntent(button.dataset.selectProject!,'tap');},{signal}));
    world.addEventListener('click',event=>{const link=(event.target as Element).closest<HTMLAnchorElement>('a[href^="/projects/"]');if(!link||event.defaultPrevented||event.button!==0||event.metaKey||event.ctrlKey||event.altKey||event.shiftKey||link.target==='_blank')return;event.preventDefault();openProject(link.pathname.split('/')[2]);},{signal});
    world.querySelectorAll<HTMLAnchorElement>('[data-project]').forEach(card=>{
      card.addEventListener('pointerenter',event=>{if(event.pointerType==='mouse')setProjectIntent(card.dataset.project!,'hover');},{signal});
      card.addEventListener('pointerleave',event=>{if(event.pointerType==='mouse')setProjectIntent(null,'hover');},{signal});
      card.addEventListener('focus',()=>setProjectIntent(card.dataset.project!,'focus'),{signal});
      card.addEventListener('blur',()=>setProjectIntent(null,'focus'),{signal});
    });
  });
  window.addEventListener('portfolio:project',event=>{update((event as CustomEvent<string>).detail);worlds.forEach(world=>world.dataset.engaged='true');},{signal});
  });
</script>
<style>
  .project-explorer{display:block;position:relative}
  .mobile-project-selector,.project-title-mobile{display:none}
  .project-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 28px;margin-top:24px;border-bottom:1px solid var(--line)}
  .project-map-column{position:relative}
  .project-map{position:relative;background:radial-gradient(ellipse at 55% 55%,#69401b24,transparent 68%),#080c0e;border:1px solid var(--edge);border-radius:var(--radius-panel);padding:26px;box-shadow:inset 0 1px #b0bdc01c}
  .world-instruction{display:flex;justify-content:space-between;gap:16px;font:400 8px/1.8 var(--mono);letter-spacing:.05em;color:var(--muted)}
  .world-instruction>span:first-child{color:var(--amber)}
  .webgl-hint{display:none}.project-map:has(.scene-island[data-state="ready"]) .webgl-hint{display:inline}.project-map:has(.scene-island[data-state="ready"]) .fallback-hint{display:none}
  .platform-canvas{height:clamp(520px,45vw,690px);margin:0 -18px;position:relative}
  .platform-canvas :global(canvas){touch-action:pan-y;cursor:default}
  .project-preview{padding:22px 24px;border:1px solid var(--edge);background:linear-gradient(135deg,#14191af5,#090d0eef);border-radius:var(--radius-panel);box-shadow:0 12px 36px #0004;min-height:0}
  .project-preview .eyebrow{font-size:8px;margin-bottom:12px}
  .project-preview h3{font-size:25px;max-width:480px;margin-bottom:14px}
  .project-preview p:not(.eyebrow){font-size:12px;line-height:1.8;max-width:480px}
  .project-preview .text-link{font-size:12px;margin-top:8px}
  .project-map>.art-caption{font-size:8px;line-height:1.8;padding:12px 8px 0;max-width:500px}
  @media(min-width:1200px){.project-preview{position:absolute;left:26px;top:65px;width:290px}.project-preview h3{font-size:22px}.project-preview p:not(.eyebrow){font-size:11px}}
  @media(max-width:1050px){.project-map{padding:16px}.platform-canvas{height:480px}.project-preview h3{font-size:22px}.project-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:800px){.platform-canvas{height:390px}.project-preview{min-height:0}.world-instruction{font-size:7px}.project-map{padding:16px}.project-list{grid-template-columns:1fr}}
  @media(max-width:400px){.platform-canvas{height:300px}}
  @media(orientation:landscape) and (max-height:500px){.platform-canvas{height:360px}.project-map-column{position:relative;top:0}}
  @media(max-width:800px){
    .project-map{padding:16px 0 0;overflow:hidden;isolation:isolate}
    .world-instruction{position:relative;z-index:2;padding-inline:16px;font-size:10px}
    .mobile-project-selector{position:relative;z-index:3;display:flex;gap:4px;overflow-x:auto;padding:8px 12px;scrollbar-width:thin}
    .mobile-project-selector button{flex-shrink:0;min-width:44px;min-height:44px;padding:8px 12px;background:transparent;border:0;border-bottom:2px solid transparent;color:var(--muted);font:11px var(--mono)}
    .mobile-project-selector button[aria-pressed='true']{color:var(--amber);border-bottom-color:var(--amber)}
    .platform-canvas{height:clamp(430px,65svh,620px);margin:0;transform:translateY(-60px);}
    .project-preview{position:absolute;z-index:3;bottom:0;left:0;right:0;padding:16px 18px max(16px,env(safe-area-inset-bottom));border:0;border-top:1px solid var(--edge);border-radius:0;background:linear-gradient(150deg,#182125f7,#0b1013fa);box-shadow:none;animation:project-sheet var(--motion-standard) var(--ease-out) both}
    .project-title-full{display:none}.project-title-mobile{display:inline}
    .project-preview>div:not([hidden]){animation:project-sheet var(--motion-standard) var(--ease-out) both}
    .project-explorer[data-engaged="true"] .project-map{padding-bottom:0}
    .project-explorer:not([data-engaged="true"]) .project-preview p:not(.eyebrow){display:none}
    .project-preview .eyebrow{font-size:10px;margin-bottom:6px}
    .project-preview h3{font-size:21px;line-height:1.15;margin-bottom:8px;max-width:32ch}
    .project-preview p:not(.eyebrow){font-size:13px;line-height:1.6;max-width:45ch}
    .project-preview .text-link{margin-top:4px;min-height:44px;font-size:13px}
    .project-map>.art-caption{display:none}
    .project-list{display:none}
    .project-explorer:has(.scene-island[data-state='fallback']) .project-list{display:grid}
  }
  @keyframes project-sheet{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
  @media(prefers-reduced-motion:reduce){.project-preview,.project-preview>div:not([hidden]){animation:none}}
</style>
