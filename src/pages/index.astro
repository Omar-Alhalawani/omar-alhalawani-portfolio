---
import SiteLayout from '../layouts/SiteLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import SceneIsland from '../components/SceneIsland';
import ExperienceCard from '../components/ExperienceCard.astro';
import VerificationVisual from '../components/VerificationVisual.astro';
import ProjectExplorer from '../components/ProjectExplorer.astro';
import { site } from '../data/site';
import { experience } from '../data/experience';
import { featuredProjects } from '../data/projects';
---
<SiteLayout>
  <div class="hero-assembly" data-hero-surface>
    <div class="world-stage" aria-hidden="true"><div class="world-window"><SceneIsland scene="hero" client:load /></div></div>
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <Eyebrow>Computer Systems Engineering</Eyebrow>
        <h1 id="hero-title"><span>Omar</span><span>Alhalawani<span class="name-period">.</span></span></h1>
        <p class="hero-statement">ASIC Verification, RTL Design,<br class="desktop-break" /> and Embedded Systems</p>
        <p class="hero-description">Carleton University engineering student building and verifying digital hardware, embedded systems, and practical engineering tools.</p>

        <div class="actions"><Button href="/projects" variant="primary">View Projects <span aria-hidden="true">↗</span></Button><Button href="/resume">View Resume <span aria-hidden="true">↗</span></Button><Button href={site.github} variant="text" external>GitHub <span aria-hidden="true">↗</span></Button></div>
      </div>
      <div class="hero-bottom"><span>OTTAWA, CANADA // CARLETON UNIVERSITY</span></div>
    </section>
  </div>
  <section id="experience" class="home-experience container section" data-reveal aria-labelledby="experience-title"><div class="section-heading"><div><Eyebrow>Experience // Ciena</Eyebrow><h2 id="experience-title">Experience</h2></div><a href="/experience" class="text-link">All experience ↗</a></div><div class="experience-grid"><ExperienceCard item={experience[0]} compact/><VerificationVisual /></div></section>
  <section class="home-projects container section" data-reveal aria-labelledby="projects-title"><div class="section-heading"><div><Eyebrow>Selected work</Eyebrow><h2 id="projects-title">Selected Projects</h2></div><a href="/projects" class="text-link">All projects ↗</a></div><ProjectExplorer projects={featuredProjects}/></section>
  <section class="home-about container section" data-reveal aria-labelledby="about-title"><div><Eyebrow>About // Carleton University</Eyebrow><h2 id="about-title">Education & Background</h2></div><div><p>B.Eng. Computer Systems Engineering, Honours Co-op at Carleton University. Expected graduation: 2029.</p><p>My focus is ASIC verification, RTL, and embedded systems, with hands-on work in research instrumentation, BioCARE, and early rover FPGA interfaces.</p><p class="background-community">Alongside engineering, I support student leadership and community programs at Carleton.</p><a href="/about" class="text-link">View background ↗</a></div></section>
  <section class="cta-band container" data-reveal><div><Eyebrow>Engineering inquiries</Eyebrow><h2>Contact</h2></div><Button href="/contact" variant="primary">Let’s connect ↗</Button></section>
</SiteLayout>
<style>
  .hero-assembly { position:relative; max-width:1800px; margin-inline:auto; }
  .world-stage { position:absolute; inset:0 0 0 auto; width:69%; z-index:0; pointer-events:auto; }
  .world-window { position:relative; top:0; height:clamp(560px,62svh,750px); min-height:560px; }
  .world-window::after { content:''; position:absolute; inset:0; background:linear-gradient(90deg,var(--bg),transparent 18%,transparent 85%,var(--bg)); pointer-events:none; }
  .hero { min-height:clamp(560px,62svh,750px); padding-block:52px 74px; position:relative; display:flex; align-items:center; }
  .hero-copy { position:relative; width:42%; z-index:2; }
  .hero .eyebrow { font-size:9px; line-height:1.8; margin-bottom:18px; }
  .eyebrow-break { display:none; }
  .hero h1 { font-size:clamp(54px,4.5vw,78px); letter-spacing:-.068em; line-height:.99; margin-bottom:22px; }
  .hero h1>span { display:block; }
  .name-period { color:var(--amber); }
  .hero-statement { font-family:var(--heading); font-size:clamp(21px,1.8vw,27px); line-height:1.3; color:var(--text); letter-spacing:-.02em; margin-bottom:20px; }
  .hero .actions { margin-top:26px; }
  .hero-description { max-width:430px; font-size:14px; line-height:1.8; }
  .hero-bottom { position:absolute; inset:auto 0 30px; display:flex; justify-content:space-between; z-index:3; font:400 9px/1.7 var(--mono); letter-spacing:.05em; color:var(--muted); gap:24px; }
  .home-experience { border-top:1px solid #343a3e70; }
  .home-about .background-community { font-size:13px; color:var(--muted); }
  .experience-grid { display:grid; grid-template-columns:.85fr 1.2fr; gap:44px; }
  .home-about { display:grid; grid-template-columns:1fr 1fr; gap:60px; background:radial-gradient(ellipse at 90% 45%,#57392024,transparent 55%); }
  .home-about p { font-size:16px; line-height:1.9; max-width:620px; }
  .home-about p+p { margin-top:22px; }
  .home-about .text-link { margin-top:24px; }
  @media (min-width:1900px) { .hero h1 { font-size:88px; } .hero-description { font-size:14px; } }
  @media (max-width:1100px) { .hero .actions { gap:8px; } .hero .button { padding-inline:14px; } .hero-copy { width:52%; } .world-stage { width:54%; } }
  @media (max-width:900px) {
    .experience-grid { grid-template-columns:1fr; gap:24px; }
    .home-about { grid-template-columns:1fr; gap:32px; }
    .home-about p { font-size:14px; }
    .hero-assembly { display:flex; flex-direction:column; }
    .hero { order:1; min-height:0; align-items:start; padding-top:56px; padding-bottom:85px; }
    .hero-copy { width:100%; max-width:580px; }
    .hero h1 { font-size:clamp(52px,12vw,78px); margin-bottom:24px; }
    .hero .eyebrow { font-size:9px; margin-bottom:20px; }
    .eyebrow-break { display:block; }
    .hero-statement { font-size:24px; }
    .hero .actions { margin-top:26px; }
  .hero-description { max-width:430px; font-size:13px; }
    .hero .actions { gap:8px; }
    .hero .button { font-size:11px; padding-inline:15px; }
    .world-stage { order:2; width:100%; position:relative; inset:auto; top:auto; height:440px; bottom:auto; margin-top:-24px; }
    .world-window { min-height:0; height:440px; position:relative; top:0; }
    .world-window::after { background:linear-gradient(0deg,var(--bg),transparent 16%,transparent 80%,var(--bg)); }
    .hero-bottom { bottom:12px; display:block; font-size:8px; }
  }
  @media (max-width:350px) {
    .hero { min-height:0; }
    .world-stage { top:auto; height:380px; }
    .world-window { height:380px; }
    .hero h1 { font-size:49px; }
    .hero-statement { font-size:22px; }
  }
  @media(max-width:800px){
    .hero{display:block;padding-top:28px;padding-bottom:40px;min-height:0}
    .hero h1{font-size:clamp(44px,12vw,58px);margin-bottom:16px}
    .hero .eyebrow{font-size:10px;margin-bottom:12px}
    .eyebrow-break{display:none}
    .hero-statement{font-size:21px;line-height:1.25;margin-bottom:12px;max-width:28ch}
    .hero-description{font-size:14px;line-height:1.65;max-width:45ch}
    .hero .actions{margin-top:18px;gap:8px}
    .hero .button{min-height:44px;font-size:12px;padding:10px 13px}
    .hero-bottom{position:static;margin-top:16px;font-size:10px;line-height:1.6}
    .hero-assembly{min-height:calc(100svh - var(--header));}
    .world-stage{height:clamp(300px,42svh,420px);margin-top:-28px}
    .world-window{height:100%;min-height:0;touch-action:pan-y}
  }
</style>
