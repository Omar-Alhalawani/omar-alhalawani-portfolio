---
import SiteLayout from '../layouts/SiteLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import VerificationVisual from '../components/VerificationVisual.astro';
import Button from '../components/Button.astro';
import {experience} from '../data/experience';
---
<SiteLayout title="Experience — Omar Alhalawani" description="ASIC verification methodology at Ciena, research instrumentation at Carleton, and teaching digital systems. Public-safe engineering experience.">
  <div class="container">
    <section class="experience-flagship" aria-label="Ciena ASIC verification experience">
      <div class="flagship-copy"><Eyebrow>Experience // ASIC verification</Eyebrow><ExperienceCard item={experience[0]} compact heading="h1"/></div>
      <VerificationVisual />
    </section>
    <section aria-label="Additional engineering experience"><h2 class="sr-only">Additional experience</h2>{experience.slice(1).map(item=><ExperienceCard item={item}/>)}</section>
    <div class="experience-note"><span class="eyebrow">Public scope</span><p>These summaries describe responsibilities and methods. They do not expose internal RTL, specifications, benchmarks, or confidential employer designs.</p></div>
    <section class="cta-band"><div><Eyebrow>Project case studies</Eyebrow><h2>Selected Projects</h2></div><Button href="/projects" variant="primary">View projects ↗</Button></section>
  </div>
</SiteLayout>
<style>
  .experience-flagship { display:grid; grid-template-columns:.9fr 1.15fr; align-items:center; gap:clamp(32px,4vw,64px); padding-block:64px 72px; }
  .flagship-copy { min-width:0; }
  .flagship-copy>.eyebrow { font-size:10px; margin-bottom:24px; }
  .experience-note { border-top:1px solid var(--line); padding-block:32px 56px; display:grid; grid-template-columns:240px 1fr; gap:60px; }
  .experience-note>.eyebrow { font-size:9px; }
  .experience-note>p { font-size:12px; max-width:720px; color:var(--muted); }
  @media(max-width:1000px) { .experience-flagship { grid-template-columns:1fr 1fr; gap:28px; } }
  @media(max-width:800px) { .experience-flagship { grid-template-columns:1fr; gap:32px; padding-block:42px 48px; } .experience-note { grid-template-columns:1fr; gap:0; } }
  @media(max-width:800px){.experience-flagship{gap:16px;padding-block:32px 40px}.flagship-copy>.eyebrow{font-size:11px;margin-bottom:16px}.experience-note{padding-block:24px 40px}}
</style>
