---
import SiteLayout from '../layouts/SiteLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import VerificationVisual from '../components/VerificationVisual.astro';
import Button from '../components/Button.astro';
import {experience} from '../data/experience';
---
<SiteLayout title="Experience — Omar Alhalawani" description="ASIC verification methodology at Ciena, research instrumentation at Carleton, and teaching digital systems. Public-safe engineering experience.">
  <div class="container"><section class="page-intro"><Eyebrow>Experience // Verification & instrumentation</Eyebrow><h1>Experience</h1><p class="lead">ASIC verification methodology, laboratory instrumentation, teaching, and hands-on electronics repair.</p></section>
    <div class="experience-opening"><p>At Ciena, my work focused on verification methodology: how a specification becomes a self-checking environment, and how to evaluate the usefulness of that environment.</p><VerificationVisual /></div>
    <section aria-label="Engineering experience"><h2 class="sr-only">Engineering experience</h2>{experience.map(item=><ExperienceCard item={item}/>)}</section>
    <div class="experience-note"><span class="eyebrow">Public scope</span><p>These summaries describe responsibilities and methods. They do not expose internal RTL, specifications, benchmarks, or confidential employer designs.</p></div>
    <section class="cta-band"><div><Eyebrow>Project case studies</Eyebrow><h2>Selected Projects</h2></div><Button href="/projects" variant="primary">View projects ↗</Button></section>
  </div>
</SiteLayout>
<style>
  .experience-opening { display:grid; grid-template-columns:.8fr 1.2fr; align-items:center; gap:70px; padding-bottom:64px; }
  .experience-opening>p { font-size:18px; line-height:1.9; max-width:430px; }
  .experience-note { border-top:1px solid var(--line); padding-block:32px 56px; display:grid; grid-template-columns:240px 1fr; gap:60px; }
  .experience-note>.eyebrow { font-size:9px; }
  .experience-note>p { font-size:12px; max-width:720px; color:var(--muted); }
  @media(max-width:800px) { .experience-opening { grid-template-columns:1fr; gap:10px; padding-bottom:40px; } .experience-opening>p { max-width:650px; font-size:16px; } .experience-note { grid-template-columns:1fr; gap:0; } }
</style>
