---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import ProjectExplorer from '../../components/ProjectExplorer.astro';
import Button from '../../components/Button.astro';
import {projects} from '../../data/projects';
---
<SiteLayout title="Projects — Omar Alhalawani" description="Source-backed projects in synchronous FIFO verification, FPGA arithmetic, EMG acquisition, optical communication, and embedded research instrumentation.">
  <div class="container"><section class="page-intro"><Eyebrow>Projects // Silicon, signal, system</Eyebrow><h1>Ideas become<br />interfaces.</h1><p class="lead">Digital logic, physical signals, and the tools that connect them. Each project has its own constraints, architecture, and evidence.</p></section>
    <section class="projects-body" aria-label="Project case studies"><ProjectExplorer projects={projects}/></section>
    <section class="cta-band"><div><Eyebrow>Read the implementation</Eyebrow><h2>The source matters.</h2><p>Public repositories are linked in each case study.<br />Illustrations explain the architecture; they are not measurements.</p></div><Button href="https://github.com/Omar-Alhalawani" external>Explore GitHub ↗</Button></section>
  </div>
</SiteLayout>
<style>.projects-body{padding-bottom:80px}.cta-band p{font-size:14px;margin-top:24px}</style>
